{
  "name": "magic-paste",
  "version": "0.1.0",
  "private": true,
  "description": "Paste exactly what you need, formatted for where you're going. A destination-aware paste extension for Chrome.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "node scripts/build.js --watch",
    "playground": "node scripts/build.js --serve",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:unit": "node --import tsx --test tests/text.test.ts tests/render.test.ts tests/destinations.test.ts",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.56.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
